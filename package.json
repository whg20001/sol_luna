{
  "name": "pi-sol-luna-router",
  "version": "0.3.0",
  "description": "Multi-provider Sol/Luna routing with Pi, Codex, and DeepSeek harness adapters",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "codex",
    "deepseek",
    "agent-harness",
    "multi-provider",
    "model-routing",
    "subagent",
    "circuit-breaker"
  ],
  "pi": {
    "extensions": [
      "./src/index.js"
    ]
  },
  "exports": {
    ".": "./src/index.js",
    "./pi": "./src/adapters/pi.js",
    "./core": "./src/core.js",
    "./model-routing": "./src/model-routing.js",
    "./router-service": "./src/router-service.js",
    "./adapters/harness": "./src/adapters/harness.js",
    "./adapters/codex": "./src/adapters/codex.js",
    "./adapters/deepseek": "./src/adapters/deepseek.js",
    "./src/index.js": "./src/index.js",
    "./src/core.js": "./src/core.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/",
    "templates/",
    "examples/",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.1 <1",
    "@earendil-works/pi-ai": ">=0.84.1 <1",
    "typebox": ">=1.3.0 <2"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check src/index.js && node --check src/core.js && node --check src/model-routing.js && node --check src/router-service.js && node --check src/adapters/pi.js && node --check src/adapters/harness.js && node --check src/adapters/codex.js && node --check src/adapters/deepseek.js && node --check examples/codex-harness.mjs && node --check examples/deepseek-harness.mjs && npm test"
  },
  "license": "MIT"
}
